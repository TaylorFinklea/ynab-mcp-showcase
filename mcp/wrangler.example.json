{
  "name": "ynab-mcp",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "logpush": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ynab-mcp",
      "database_id": "REPLACE_AT_DEPLOY",
      "migrations_dir": "../migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "REPLACE_AT_DEPLOY"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://ynab-mcp.example.com",
    "OWNER_EMAIL": "you@example.com",
    "ACCESS_TEAM_DOMAIN": "https://your-team.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_AT_DEPLOY",
    "ALLOWED_REDIRECT_HOSTS": "claude.ai,claude.com"
  },
  "routes": [
    {
      "pattern": "ynab-mcp.example.com",
      "custom_domain": true
    }
  ]
}
